#include <winver.h>
#include "../src/version.h"

1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION ATHER_VERSION_MAJOR, ATHER_VERSION_MINOR, ATHER_VERSION_PATCH, 0
 PRODUCTVERSION ATHER_VERSION_MAJOR, ATHER_VERSION_MINOR, ATHER_VERSION_PATCH, 0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Ather"
            VALUE "FileDescription", "Ather Screenshot"
            VALUE "FileVersion", ATHER_VERSION_STR
            VALUE "InternalName", "AtherScreenshot"
            VALUE "LegalCopyright", "Ather"
            VALUE "OriginalFilename", "AtherScreenshot.exe"
            VALUE "ProductName", "Ather Screenshot"
            VALUE "ProductVersion", ATHER_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
